{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 110MB
	}

	handle /api/* {
		reverse_proxy {
			dynamic a {
				name backend
				port 8000
				refresh 10s
			}
			lb_policy least_conn
			lb_try_duration 5s
		}
	}

	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=2592000"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
