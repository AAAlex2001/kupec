# Сайт
DOMAIN=kupecmarket.ru
NEXT_PUBLIC_SITE_URL=https://kupecmarket.ru

# База. В Docker DATABASE_URL собирается из POSTGRES_*, а этот — для запуска без Docker
POSTGRES_DB=kupec
POSTGRES_USER=kupec
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://kupec:kupec@localhost:5432/kupec
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Бэкенд
CORS_ORIGINS=["https://kupecmarket.ru"]
DEBUG=false
COOKIE_SECURE=true
MEDIA_DIR=media
CODE_SECRET=
SESSION_EXPIRES_DAYS=30

# Почта. Пустой SMTP_HOST — письма с кодами пишутся в лог бэкенда
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Купец <no-reply@kupecmarket.ru>

# ИИ-помощник постов через ProxyAPI. Пустой ключ — помощник выключен
PROXYAPI_KEY=
AI_MODEL=deepseek/deepseek-v3.2
AI_REQUESTS_PER_HOUR=30

# Кросспостинг в Telegram-каналы. Пустой токен — выключен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Если сервер не видит api.telegram.org: http://логин:пароль@хост:порт
TELEGRAM_PROXY=

# Фронтенд. В Docker API_INTERNAL_URL задаёт docker-compose.yml
API_INTERNAL_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
NEXT_PUBLIC_LIGHTGALLERY_LICENSE_KEY=
